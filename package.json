{
  "name": "jiokoe",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Jiokoe — a commitment wallet. Lock your money, get it back on your own schedule.",
  "scripts": {
    "dev": "vite",
    "build": "npm run audit:prod && npm run pwa:icons && vite build",
    "preview": "vite preview",
    "start": "node server.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "test:fees": "node scripts/test-fees.mjs",
    "build:mobile": "npm run build && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npm run build:mobile && npx cap run android",
    "cap:run:ios": "npm run build:mobile && npx cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@supabase/supabase-js": "^2.110.2",
    "capacitor-native-biometric": "^4.2.2",
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "serve": "14.2.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^1.3.0"
  }
}
